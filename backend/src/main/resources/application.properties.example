spring.application.name=techstore-backend

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5433/techstoredb}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:TechStoreDb@2026}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

server.port=8081

app.cookie.secure=false
app.frontend.base-url=${APP_FRONTEND_BASE_URL:http://localhost:3000}
app.cors.allowed-origin-patterns=${APP_CORS_ALLOWED_ORIGIN_PATTERNS:http://localhost:3000,http://127.0.0.1:3000}

jwt.secret=${JWT_SECRET:change_me_to_a_unique_base64_secret_32_bytes_min}

app.seed.admin-email=admin@techstore.local
app.seed.admin-password=Admin@123
app.seed.seller-email=seller@techstore.local
app.seed.seller-password=Seller@123
